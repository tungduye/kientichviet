{
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/(.*)\\.usdz",
      "headers": [
        {
          "key": "Content-Type",
          "value": "model/vnd.usdz+zip"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!images/|models/|audio/|assets/|vendor/|ar-targets/|favicon.png|robots.txt).*)",
      "destination": "/index.html"
    }
  ]
}
